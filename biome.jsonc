{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "useEditorconfig": true,
    "lineWidth": 100
  },
  "linter": {
    "domains": {
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "rules": {
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noImportantStyles": "error",
        "noPlaywrightUselessAwait": "error",
        "noRedundantDefaultExport": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error",
        "useMathMinMax": "error",
        "useMaxParams": "error",
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useRegexpTest": "error",
        "useSimpleNumberKeys": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noPrivateImports": "error",
        "noProcessGlobal": "error",
        "noUndeclaredVariables": "error",
        // noUnresolvedImports has too many bugs, including:
        // https://github.com/biomejs/biome/issues/8849
        "noUnresolvedImports": "off",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedInstantiation": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js"
            }
          }
        },
        "useJsonImportAttributes": "error",
        "useParseIntRadix": "error",
        "useSingleJsDocAsterisk": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noDelete": "error",
        "noDynamicNamespaceImportAccess": "error",
        "noNamespaceImport": "error",
        "useDomNodeTextContent": "error",
        "useTopLevelRegex": "error"
      },
      "security": {
        "useIframeSandbox": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDescendingSpecificity": "error",
        // noDoneCallback flags on Vite context ?
        "noDoneCallback": "error",
        "noExportedImports": "error",
        "noInferrableTypes": "error",
        "noInlineStyles": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightWaitForSelector": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noYodaExpression": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": {
          "level": "error",
          "options": {
            "style": "method"
          }
        },
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useDeprecatedReason": "error",
        "useDomQuerySelector": "error",
        "useErrorCause": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useForOf": "error",
        "useGlobalThis": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": "error",
        "useImportsFirst": "error",
        "useLiteralEnumMembers": "error",
        "useNamedCaptureGroup": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReduceTypeParameter": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": {
          "level": "error",
          "options": {
            "ignoreClassesWithImplements": "all",
            "ignoreOverrideMethods": true
          }
        },
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnicodeRegex": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noApproximativeNumericConstant": "error",
        "noBitwiseOperators": "error",
        "noCatchAssign": "error",
        "noConditionalExpect": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        },
        "noConstEnum": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noDeprecatedMediaType": "error",
        "noDocumentCookie": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noDuplicateSelectors": "error",
        "noEmptyBlock": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyObjectKeys": "error",
        "noEmptySource": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noIdenticalTestTitle": "error",
        "noImportCycles": "error",
        "noIrregularWhitespace": "error",
        "noLoopFunc": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noQuickfixBiome": "error",
        "noRedundantUseStrict": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUnnecessaryConditions": "error",
        "noUntrustedLicenses": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "useAdjacentOverloadSignatures": "error",
        "useArraySortCompare": "error",
        // useAwait incorrectly flags cases when a promise is returned
        // https://github.com/biomejs/biome/issues/1161
        "useAwait": "off",
        "useBaseline": "error",
        "useBiomeIgnoreFolder": "error",
        "useDefaultSwitchClauseLast": "error",
        "useErrorMessage": "error",
        "useExpect": "error",
        "useGoogleFontDisplay": "error",
        "useIsArray": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**"],
      "linter": {
        "rules": {
          "performance": {
            // useTopLevelRegex is unreasonable for test cases
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}

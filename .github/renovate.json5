{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>kitware-resonant/.github:renovate-library-core.json5',
  ],
  packageRules: [
    {
      matchPackageNames: ['@biomejs/biome'],
      matchUpdateTypes: ['major', 'minor'],
      groupName: 'biome',
      automerge: false,
    },
  ],
}
